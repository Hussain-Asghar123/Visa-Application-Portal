{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "account/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "applicant/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(private|includes|database)/.*",
      "status": 403
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
